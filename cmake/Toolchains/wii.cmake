set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR powerpc)
set(WII ON CACHE BOOL "Nintendo Wii build" FORCE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT DEFINED ENV{DEVKITPRO})
  message(FATAL_ERROR "Set DEVKITPRO to your devkitPro installation")
endif()
if(DEFINED ENV{DEVKITPPC})
  set(WII_PPC "$ENV{DEVKITPPC}")
else()
  set(WII_PPC "$ENV{DEVKITPRO}/devkitPPC")
endif()
set(CMAKE_C_COMPILER "${WII_PPC}/bin/powerpc-eabi-gcc")
set(CMAKE_CXX_COMPILER "${WII_PPC}/bin/powerpc-eabi-g++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_FIND_ROOT_PATH "${WII_PPC}" "$ENV{DEVKITPRO}/libogc2/wii" "$ENV{DEVKITPRO}/portlibs/ppc")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-mrvl -mcpu=750 -meabi -mhard-float -DGEKKO -DHW_RVL")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
